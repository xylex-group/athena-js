{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "@xylex-group/athena": [
        "./../../src/index.ts"
      ],
      "@xylex-group/athena/*": [
        "./../../src/*"
      ],
      "@xylex-group/athena/admin": [
        "./../../src/admin/index.ts"
      ],
      "@xylex-group/athena/email": [
        "./../../src/email/public.ts"
      ],
      "@xylex-group/athena/email/node": [
        "./../../src/email-node/index.ts"
      ],
      "@xylex-group/athena/utils": [
        "./../../src/utils/index.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts"
  ]
}