{
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "test/**/*.ts",
    "test-sdk/src/**/*.ts",
    "scripts/verify-auth-migration-history.d.mts",
    "scripts/verify-auth-schema-release.d.mts",
    "bin/bootstrap-logging.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "examples",
    "test/fixtures",
    "test-sdk/node_modules"
  ]
}
