{
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*.ts", "test-sdk/src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "examples",
    "test/fixtures",
    "test-sdk/node_modules"
  ]
}
