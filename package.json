    "check:exports": "node scripts/inspect-package.mjs",
    "check:publint": "publint",
    "check:tarball": "node scripts/check-release-tarball.mjs",
    "postpack": "node scripts/pack-self-link-manifest.mjs restore",
    "prepack": "node scripts/pack-self-link-manifest.mjs strip",
    "cli:dev": "node scripts/ensure-dev-self-link.mjs && node --import tsx src/cli/bin.ts",
    "docs:check": "node --import tsx scripts/docs/cli.mts --check && node scripts/check-docs-consistency.mjs",
    "docs:coverage": "node --import tsx scripts/docs/cli.mts --coverage",
    "docs:generate": "node --import tsx scripts/docs/cli.mts",
    "audit:runtime-boundaries": "node scripts/audit-runtime-boundaries.mjs",
    "test:node-import": "node scripts/test-package-node-import.mjs",
    "test:stabilization-finality": "node scripts/run-stabilization-finality.mjs",
    "check:release": "pnpm lint && pnpm typecheck:all && pnpm test && pnpm build && pnpm test:browser-bundle && node scripts/audit-runtime-boundaries.mjs && node scripts/test-package-node-import.mjs && pnpm audit:rn && pnpm check:exports && pnpm check:publint && pnpm check:attw && pnpm check:tarball && pnpm docs:check && node scripts/check-structural-complexity.mjs",
    "dev": "node scripts/assert-published-dts.mjs && ATHENA_TSUP_WATCH=1 tsup --watch",
    "docs:methods": "node --import tsx scripts/docs/cli.mts",
    "generate:error-ir": "node scripts/generate-error-ir.mjs",
    "example:admin": "tsx examples/node/admin-permission.ts",
    "example:auth-session": "tsx examples/node/auth-session.ts",
    "example:billing": "tsx examples/node/billing.ts",
    "example:cloudflare": "pnpm typecheck:examples",
    "example:env": "tsx examples/node/env.ts",
    "example:node": "tsx examples/node/create-client.ts",
    "example:session": "tsc -p examples/session/tsconfig.json",
    "example:storage": "tsx examples/node/storage.ts",
    "fix": "ultracite fix",
    "format": "ultracite fix",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "pnpm lint -- --fix",
    "finality": "node scripts/run-finality.mjs",
    "prepublishOnly": "pnpm release:verify",
    "publish:token": "node scripts/publish.js",
    "release:verify": "node scripts/verify-auth-schema-release.mjs && pnpm test:finality && pnpm test:tarball && pnpm test:examples && pnpm check:attw",
    "test": "node scripts/run-unit-tests.mjs",
    "test:examples": "pnpm typecheck:examples && node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/examples-session.test.ts",
    "test:finality": "node scripts/run-finality.mjs",
    "test:tarball": "node scripts/check-release-tarball.mjs",
    "test:react-native": "node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/react-native-adapter.test.ts",
    "test:expo-fixture": "pnpm --dir test/fixtures/expo check",
    "audit:consumer": "node scripts/audit-consumer-athena-usage.mjs",
    "audit:rn": "node scripts/audit-rn-bundle-safety.mjs",
    "test:browser-bundle": "node scripts/audit-browser-bundle-safety.mjs",
    "postgres:up": "node scripts/run-postgres-docker-tests.mjs --up-only",
    "postgres:down": "node scripts/run-postgres-docker-tests.mjs --down",
    "test:postgres": "node scripts/run-postgres-docker-tests.mjs",
    "test:integration:postgres": "node scripts/run-postgres-docker-tests.mjs --all",
    "test:policy-conformance": "node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/sdd/athena-local-runtime.r7.test.ts test/sdd/athena-local-runtime.r3.test.ts",
    "auth:route-parity": "node scripts/auth-route-parity.mjs --print",
    "test:parity": "node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/finality-parity-suite.test.ts test/finality-password-portability.test.ts test/finality-portability.test.ts test/admin-auth-parity.test.ts test/admin-auth-portability.test.ts test/auth-route-inventory.test.ts test/auth-embedded-tier-a.test.ts test/email-parity.test.ts",
    "test:email-parity": "node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/email-parity.test.ts test/email-architecture.test.ts test/email-auth-injection.test.ts",
    "test:parity:live": "node scripts/run-parity-live.mjs",
    "test:embedded-next": "node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/finality-handlers-from-root.test.ts test/sdd/athena-local-runtime.r5.security.test.ts test/conformance/act-5-1-embedded.test.ts",
    "test:query-ast": "node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/query-engine-*.test.ts test/postgres-compile-ast*.test.ts test/d1-compile-ast*.test.ts test/gateway-serialize-ast.test.ts test/query-ast.test.ts test/query-ast-act.test.ts test/query-ast-parity.test.ts",
    "test:query-parity": "node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/query-ast-parity.test.ts test/query-ast-act.test.ts",
    "test:conformance": "node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/conformance/**/*.test.ts",
    "test:sdd": "node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/sdd/**/*.test.ts",
    "test:billing-release": "node scripts/run-release-gates.mjs --billing",
    "test:auth-schema-release": "node scripts/run-release-gates.mjs --auth-schema",
    "test:watch": "node --import ./test/register-server-only.mjs --import tsx --test --watch test/*.test.ts test/auth/**/*.test.ts test/sdd/**/*.test.ts",
    "typecheck": "node scripts/ensure-dev-self-link.mjs && tsc -p tsconfig.typecheck.json",
    "typecheck:examples": "node scripts/ensure-dev-self-link.mjs && tsc -p examples/cloudflare/tsconfig.json && tsc -p examples/node/tsconfig.json && tsc -p examples/session/tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.full.json --noEmit",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:examples && pnpm typecheck:tests",
    "test:migrations": "node --import ./test/register-server-only.mjs --import tsx --test --test-force-exit test/migrations*.test.ts test/cli-migrate.test.ts",
    "sync:mirror": "node scripts/sync-mirror.mjs"
