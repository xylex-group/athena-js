{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@xylex-group/athena": ["../../../src/index.ts"],
      "@xylex-group/athena/*": ["../../../src/*"],
      "@xylex-group/athena/react": ["../../../src/react/index.ts"],
      "@xylex-group/athena/next/server": ["../../../src/next/server.ts"],
      "@xylex-group/athena/next/client": ["../../../src/next/client.ts"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../../../src/external-modules.d.ts",
    "../../../src/react/use-sync-external-store-shim.d.ts"
  ]
}
