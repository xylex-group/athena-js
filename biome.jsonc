{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["ultracite/biome/core"],
  "linter": {
    "rules": {
      "complexity": {
        // Large generated/hand-written runners (D1, CRUD workers, clients) exceed
        // Ultracite defaults; full decompositions tracked separately from lint clean.
        "noExcessiveCognitiveComplexity": "off",
        "noForEach": "off",
        // Fire-and-forget CLI entrypoints and intentional discard of promises.
        "noVoid": "off",
        // Formatted code uses implicit undefined instead of `return undefined`.
        "noUselessUndefined": "off"
      },
      "performance": {
        // Package public surface is intentional barrels (export * / re-exports).
        "noBarrelFile": "off",
        "noAwaitInLoops": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off",
        // Regex literals in one-shot parsers/scripts; hoist cost >> benefit here.
        "useTopLevelRegex": "off",
        // Record/map key deletion is required for AST/shape rewrites.
        "noDelete": "off"
      },
      "style": {
        "noIncrementDecrement": "off",
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "noParameterProperties": "off",
        // Public API re-exports: import then export for local use + surface.
        "noExportedImports": "off",
        "useConsistentMethodSignatures": "off",
        "useDestructuring": "off",
        // Public surface mixes `interface` (declaration merging / extends) and `type`.
        "useConsistentTypeDefinitions": "off",
        // Domain errors remap parse/provider failures; custom constructors are not
        // `new Error(msg, { cause })` so this rule is mostly false-positive.
        "useErrorCause": "off",
        "useAtIndex": "off",
        "useConsistentArrayType": "off",
        "useReadonlyClassProperties": "off",
        "useTemplate": "off",
        // Exhaustive unions use `never` in default, not a runtime default clause.
        "useDefaultSwitchClause": "off"
      },
      "suspicious": {
        "noEmptyBlockStatements": "off",
        // Bitmask flags in scripts and Discord permissions.
        "noBitwiseOperators": "off",
        "noShadow": "off",
        // Strict narrowing after unsafe autofixes produces many false positives.
        "noUnnecessaryConditions": "off",
        // Cloudflare Worker handlers and test fetch mocks are async by contract
        // even when the body is sync.
        "useAwait": "off",
        // `== null` is the package nullish idiom (null | undefined).
        "noEqualsToNull": "off",
        "useArraySortCompare": "off",
        "noEvolvingTypes": "off",
        // CLI `run` returns void or CommandResult; `undefined` is not equivalent.
        "noConfusingVoidType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["package.json"],
      "linter": {
        "rules": {
          "suspicious": {
            // `pg` is a runtime dependency and an optional peer for consumers.
            "noDuplicateDependencies": "off"
          }
        }
      }
    }
  ]
}
